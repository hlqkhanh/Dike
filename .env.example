# Copy this file to .env only when a later stage introduces runtime services.
# Never place real credentials or personal data in this example.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001/api/v1

# Stage 1 connection values are intentionally blank. Generate local values from
# the infrastructure documentation; never commit a complete connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/dike?replicaSet=rs0
REDIS_URL=redis://:replace-with-local-random-password@127.0.0.1:6379/0
REDIS_PASSWORD=replace-with-local-random-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_PUBLIC=dike-local-public
S3_BUCKET_PRIVATE=dike-local-private
S3_ACCESS_KEY=replace-with-local-random-access-key
S3_SECRET_KEY=replace-with-local-random-secret-key
S3_REGION=us-east-1

WORKER_CONCURRENCY=2
WORKER_JOB_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=1000

# Stage 2 authentication. Replace every placeholder with an independent random
# value. Mock auth and the phone OTP bypass are rejected outside local/test.
AUTH_PROVIDER=mock
GOOGLE_CLIENT_ID=dike-local-client
GOOGLE_CLIENT_SECRET=replace-with-local-google-or-mock-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
MOCK_OIDC_ISSUER=http://127.0.0.1:3002
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_MAX_SESSIONS=10
AUTH_TRANSACTION_TTL_SECONDS=600
AUTH_RATE_LIMIT_PREFIX=auth:rate
AUTH_TOKEN_KEYRING={"replace-id":"replace-with-at-least-32-random-characters"}
AUTH_TOKEN_ACTIVE_KEY_ID=replace-id
PII_KEYRING={"replace-id":"replace-with-different-32-random-characters"}
PII_ACTIVE_KEY_ID=replace-id
CSRF_KEYRING={"replace-id":"replace-with-another-32-random-characters"}
CSRF_ACTIVE_KEY_ID=replace-id
BFF_KEYRING={"replace-id":"replace-with-a-fourth-32-random-characters"}
BFF_ACTIVE_KEY_ID=replace-id
REQUIRE_PHONE_OTP=false
TRUST_PROXY_HOPS=0

