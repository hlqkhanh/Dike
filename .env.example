# Copy this file to .env only when a later stage introduces runtime services.
# Never place real credentials or personal data in this example.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Stage 1 connection values are intentionally blank. Generate local values from
# the infrastructure documentation; never commit a complete connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/dike?replicaSet=rs0
REDIS_URL=redis://:replace-with-local-random-password@127.0.0.1:6379/0
REDIS_PASSWORD=replace-with-local-random-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_PUBLIC=dike-local-public
S3_BUCKET_PRIVATE=dike-local-private
S3_ACCESS_KEY=replace-with-local-random-access-key
S3_SECRET_KEY=replace-with-local-random-secret-key
S3_REGION=us-east-1

WORKER_CONCURRENCY=2
WORKER_JOB_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=1000

