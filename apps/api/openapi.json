  "info": {
    "title": "Dike API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "GoogleStartDto": {
        "type": "object",
        "properties": {
          "returnTo": {
            "type": "string",
            "enum": ["/app", "/onboarding/phone", "/settings/sessions"]
          }
        },
        "required": ["returnTo"]
      },
      "GoogleStartResponseDto": {
        "type": "object",
        "properties": {
          "authorizationUrl": {
            "type": "string",
            "format": "uri"
          },
          "transactionToken": {
            "type": "string",
            "writeOnly": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["authorizationUrl", "transactionToken", "expiresAt"]
      },
      "GoogleCallbackDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "writeOnly": true
          },
          "state": {
            "type": "string",
            "writeOnly": true
          },
          "transactionToken": {
            "type": "string",
            "writeOnly": true
          },
          "providerError": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["state", "transactionToken"]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["MEMBER", "VERIFIED_MEMBER", "APPROVED_DRIVER", "MODERATOR", "ADMIN"]
            }
          },
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "phoneStatus": {
            "type": "string",
            "enum": ["NONE", "UNVERIFIED", "VERIFIED"]
          },
          "maskedPhone": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["roles", "id", "displayName", "phoneStatus"]
      },
      "DeviceSummaryDto": {
        "type": "object",
        "properties": {
          "browser": {
            "type": "string"
          },
          "operatingSystem": {
            "type": "string"
          },
          "deviceType": {
            "type": "string",
            "enum": ["DESKTOP", "MOBILE", "TABLET", "UNKNOWN"]
          }
        },
        "required": ["browser", "operatingSystem", "deviceType"]
      },
      "CurrentSessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "current": {
            "type": "boolean",
            "enum": [true]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "absoluteExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceSummaryDto"
          }
        },
        "required": [
          "id",
          "current",
          "createdAt",
          "lastSeenAt",
          "accessExpiresAt",
          "absoluteExpiresAt",
          "device"
        ]
      },
      "OnboardingDto": {
        "type": "object",
        "properties": {
          "nextAction": {
            "type": "string",
            "enum": ["PHONE_REQUIRED", "PHONE_VERIFICATION_REQUIRED", "NONE"]
          }
        },
        "required": ["nextAction"]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [true]
          },
          "csrfToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "session": {
            "$ref": "#/components/schemas/CurrentSessionDto"
          },
          "onboarding": {
            "$ref": "#/components/schemas/OnboardingDto"
          }
        },
        "required": ["authenticated", "csrfToken", "user", "session", "onboarding"]
      },
      "TokenSessionResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "writeOnly": true
          },
          "refreshToken": {
            "type": "string",
            "writeOnly": true
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "session": {
            "$ref": "#/components/schemas/AuthSessionResponseDto"
          },
          "returnTo": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessExpiresAt",
          "refreshExpiresAt",
          "session"
        ]
      },
      "RefreshSessionDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["refreshToken"]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "writeOnly": true
          },
          "refreshToken": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "DeviceSessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceSummaryDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "absoluteExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "current", "device", "createdAt", "lastSeenAt", "absoluteExpiresAt"]
      },
      "RevokeSessionResponseDto": {
        "type": "object",
        "properties": {
          "revokedCurrent": {
            "type": "boolean"
          }
        },
        "required": ["revokedCurrent"]
      },
      "UpdatePhoneDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+84901234567"
          }
        },
        "required": ["phone"]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable"]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["up", "down"]
                }
              }
            }
          }
        },
        "required": ["status", "requestId"]
      },
      "PhoneOtpChallengeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationMasked": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time"
          },
          "attemptsRemaining": {
            "type": "number"
          },
          "developmentCode": {
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "destinationMasked",
          "expiresAt",
          "resendAvailableAt",
          "attemptsRemaining"
        ]
      },
      "PhoneVerificationDto": {
        "type": "object",
        "properties": {
          "phoneStatus": {
            "type": "string",
            "enum": ["NONE", "UNVERIFIED", "VERIFIED"]
          },
          "challenge": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PhoneOtpChallengeDto"
              }
            ]
          }
        },
        "required": ["phoneStatus", "challenge"]
      },
      "VerifyPhoneOtpDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": ["challengeId", "code"]
      }
    }
  }
}
