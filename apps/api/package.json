{
  "name": "@dike/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/main.ts",
    "build": "tsc -p tsconfig.build.json && corepack pnpm openapi:generate",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/**/*.integration.test.ts",
    "test:integration": "vitest run test/database.integration.test.ts test/auth.integration.test.ts test/stage3.integration.test.ts",
    "openapi:generate": "tsx src/openapi/generate.ts && corepack pnpm exec prettier --write openapi.json",
    "db:migrate": "tsx --env-file=../../.env.local src/database/migration-cli.ts up",
    "db:migrate:status": "tsx --env-file=../../.env.local src/database/migration-cli.ts status",
    "db:seed": "tsx --env-file=../../.env.local src/database/seed-cli.ts",
    "auth:role:list": "tsx --env-file=../../.env.local src/authorization/role-cli.ts list",
    "auth:role:bootstrap-admin": "tsx --env-file=../../.env.local src/authorization/role-cli.ts bootstrap-admin",
    "auth:role:grant": "tsx --env-file=../../.env.local src/authorization/role-cli.ts grant",
    "auth:role:revoke": "tsx --env-file=../../.env.local src/authorization/role-cli.ts revoke"
  },
  "dependencies": {
    "@dike/config": "workspace:*",
    "@dike/contracts": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.1.0",
    "libphonenumber-js": "1.12.33",
    "mongoose": "9.10.3",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.0",
    "tsx": "4.20.6",
    "vitest": "5.0.3"
  }
}
