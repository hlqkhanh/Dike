{
  "name": "@dike/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/**/*.integration.test.ts",
    "test:integration": "vitest run test/worker.integration.test.ts"
  },
  "dependencies": {
    "@dike/config": "workspace:*",
    "@dike/contracts": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "mongoose": "9.10.3",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "vitest": "5.0.3"
  }
}
