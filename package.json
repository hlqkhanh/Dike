{
  "name": "dike",
  "version": "0.1.0",
  "private": true,
  "description": "Greenfield monorepo for the Dike ride-sharing production pilot.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "corepack pnpm --filter \"./packages/**\" build && node scripts/run-workspaces.mjs dev --parallel",
    "dev:google": "node scripts/dev.mjs --google",
    "build": "node scripts/run-workspaces.mjs build",
    "test": "corepack pnpm --filter \"./packages/**\" build && node scripts/run-workspaces.mjs test",
    "test:integration": "corepack pnpm --filter \"./packages/**\" build && node scripts/run-workspaces.mjs test:integration",
    "test:e2e:auth": "corepack pnpm --filter @dike/web test:e2e:auth",
    "lint": "eslint \"*.mjs\" scripts --max-warnings=0 && node scripts/run-workspaces.mjs lint",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:reset": "node scripts/infra.mjs reset",
    "db:migrate": "corepack pnpm --filter @dike/api db:migrate",
    "db:migrate:status": "corepack pnpm --filter @dike/api db:migrate:status",
    "db:seed": "corepack pnpm --filter @dike/api db:seed",
    "api:generate": "corepack pnpm --filter @dike/api-client generate",
    "api:check": "corepack pnpm --filter @dike/api-client check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:secrets": "secretlint \"**/*\"",
    "security:audit": "corepack pnpm audit --prod --audit-level high",
    "sbom": "cdxgen -t js --no-recurse --no-install-deps --fail-on-error --output sbom.cdx.json .",
    "ci": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm api:check && corepack pnpm security:secrets",
    "prepare": "husky",
    "auth:role:list": "corepack pnpm --filter @dike/api auth:role:list",
    "auth:role:bootstrap-admin": "corepack pnpm --filter @dike/api auth:role:bootstrap-admin",
    "auth:role:grant": "corepack pnpm --filter @dike/api auth:role:grant",
    "auth:role:revoke": "corepack pnpm --filter @dike/api auth:role:revoke"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write",
      "secretlint"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write",
      "secretlint"
    ],
    "*": "secretlint"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@cyclonedx/cdxgen": "12.8.5",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "11.2.4",
    "@types/node": "22.18.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "secretlint": "11.2.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  }
}
